# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ImageKit (image storage)
# Public key + optional URL endpoint are exposed to the browser.
VITE_IMAGEKIT_PUBLIC_KEY=public_xxx
# VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Private key is SERVER-ONLY — read by api/imagekit-auth.ts. Never prefix with VITE_.
IMAGEKIT_PRIVATE_KEY=private_xxx

# PostHog (US Cloud)
VITE_POSTHOG_KEY=phc_xxx
# Optional. Defaults to the /ingest reverse proxy (see vite.config.ts).
# Set to https://us.i.posthog.com to hit PostHog US directly.
# VITE_POSTHOG_HOST=https://us.i.posthog.com
